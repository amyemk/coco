# AI/LLM API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Coda API
CODA_API_TOKEN=your_coda_api_token_here

# Database Encryption (generate with: python -c "import secrets; print(secrets.token_hex(32))")
DATABASE_ENCRYPTION_KEY=your_database_encryption_key_here

# Email Delivery (if using SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password_here

# Optional: SendGrid API Key (alternative to SMTP)
# SENDGRID_API_KEY=your_sendgrid_api_key_here

# Environment
ENVIRONMENT=development  # or production

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# Application Settings
APP_NAME=AI Chief of Staff
APP_VERSION=1.0.0
